# Sample environment variables for topbar config
# Copy to .env and fill in your API keys for live news

NEWDATA_API_KEY=
MEDIASTACK_API_KEY=

# Default city shown if user denies geolocation
TOPBAR_DEFAULT_CITY_NAME=Nairobi
TOPBAR_DEFAULT_LAT=-1.286389
TOPBAR_DEFAULT_LON=36.817223

# Server port (optional)
PORT=3000
